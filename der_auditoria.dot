digraph DER_AUDIT {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.6, bgcolor="white",
         fontname="Helvetica",
         label="Auditoría del catálogo — tabla única audit_log\nAudita: domain · subdomain · collection · collection_owner · collection_table\nrecord_pk en JSON (soporta PK simple y compuesta) · append-only",
         labelloc="t", fontsize=18];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#9aa0a6", arrowsize=0.8];

  /* ===== Tablas auditadas (resumidas, solo PK) ===== */
  domain [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>DOMAIN</b></font></td></tr>
      <tr><td align="left"><b>domain_id</b></td><td align="left">BIGINT PK</td></tr>
    </table>>];

  subdomain [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>SUBDOMAIN</b></font></td></tr>
      <tr><td align="left"><b>subdomain_id</b></td><td align="left">BIGINT PK</td></tr>
    </table>>];

  collection [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>COLLECTION</b></font></td></tr>
      <tr><td align="left"><b>collection_id</b></td><td align="left">BIGINT PK</td></tr>
    </table>>];

  collection_owner [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#eef4fb">
      <tr><td bgcolor="#2b5f8a" colspan="2"><font color="white"><b>COLLECTION_OWNER</b></font></td></tr>
      <tr><td align="left"><b>collection_id</b></td><td align="left">BIGINT PK</td></tr>
      <tr><td align="left"><b>owner_entra_id</b></td><td align="left">STRING PK</td></tr>
    </table>>];

  collection_table [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#fff6e6">
      <tr><td bgcolor="#b26a00" colspan="2"><font color="white"><b>COLLECTION_TABLE</b></font></td></tr>
      <tr><td align="left"><b>collection_id</b></td><td align="left">BIGINT PK</td></tr>
      <tr><td align="left"><b>data_table_id</b></td><td align="left">BIGINT PK</td></tr>
    </table>>];

  /* ===== Tabla de auditoría unica ===== */
  audit_log [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#eeeeee">
      <tr><td bgcolor="#555555" colspan="2"><font color="white"><b>AUDIT_LOG</b> (unica, append-only)</font></td></tr>
      <tr><td align="left"><b>audit_id</b></td><td align="left">BIGINT PK (unico)</td></tr>
      <tr><td align="left">table_name</td><td align="left">STRING</td></tr>
      <tr><td align="left">record_pk</td><td align="left">STRING (JSON de la PK)</td></tr>
      <tr><td align="left">action</td><td align="left">INSERT/UPDATE/DELETE</td></tr>
      <tr><td align="left">changed_at</td><td align="left">TIMESTAMP</td></tr>
      <tr><td align="left">changed_by_entra_id</td><td align="left">STRING (snapshot)</td></tr>
      <tr><td align="left">changed_by_email</td><td align="left">STRING (snapshot)</td></tr>
      <tr><td align="left">old_values</td><td align="left">STRING (JSON)</td></tr>
      <tr><td align="left">new_values</td><td align="left">STRING (JSON)</td></tr>
    </table>>];

  /* Nota de la clave logica */
  nota [shape=note, fillcolor="#fff8e1", style="filled", fontsize=11, label=
"Clave logica (NO unique): (table_name, record_pk)\naudit_id es la PK unica real.\nrecord_pk guarda la PK en JSON:\n  simple    -> {\"collection_id\":4217}\n  compuesta -> {\"collection_id\":4217,\"owner_entra_id\":\"...\"}"];

  /* ===== Aristas: cada tabla es auditada por audit_log ===== */
  domain           -> audit_log [style=dotted, arrowhead=vee, label="audita"];
  subdomain        -> audit_log [style=dotted, arrowhead=vee, label="audita"];
  collection       -> audit_log [style=dotted, arrowhead=vee, label="audita"];
  collection_owner -> audit_log [style=dotted, arrowhead=vee, label="audita (PK compuesta)"];
  collection_table -> audit_log [style=dotted, arrowhead=vee, label="audita (PK compuesta)"];

  nota -> audit_log [style=invis];
}
